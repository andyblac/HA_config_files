{% macro relative(entity) %}
  {% set entity_state = states(entity) %}
  {% if entity_state in ['unknown', 'unavailable', 'none'] %}
    unknown
  {% else %}
    {% set time_diff = (as_timestamp(now()) - as_timestamp(entity_state, default=0)) | round(0) %}
    {% if time_diff > 86400 %}
      {{ (time_diff / 86400) | int }} days
    {% elif time_diff > 3600 %}
      {{ (time_diff / 3600) | int }} hours
    {% elif time_diff > 60 %}
      {{ (time_diff / 60) | int }} minutes
    {% else %}
      {{ time_diff | int }} seconds
    {% endif %}
  {% endif %}
{% endmacro %}
